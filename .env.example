# Copy to .env for local development. Never commit real secrets.

POSTGRES_USER=agri
POSTGRES_PASSWORD=agri
POSTGRES_DB=agri
DATABASE_URL=postgresql+psycopg://agri:agri@db:5432/agri

SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

SEED_DEMO=true
FARM_TIMEZONE=Africa/Casablanca
SUMMARY_ONLY_MODE=false
FORCE_ANALYSIS_FAILURE=false

VITE_API_URL=http://localhost:8000/api/v1

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Responder
RESPONDER_WEBHOOK_SECRET=dev-responder-secret
API_INTERNAL_URL=http://api:8000
API_OPS_TOKEN=dev-ops-token
